PORT=3000
NODE_ENV=local

# WAHA
WAHA_URL=
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# PostgreSQL optional. If empty, the bot uses local files in bot/data.
DATABASE_URL=

# Supabase Storage optional, used for final message image.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=finalmessageassets

# Admin login
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_SECRET=

# Gemini optional fallback
GEMINI_API_KEY=

# Internal platform identification confirmation.
PLATFORM_CONFIRMATION_ENABLED=true

# CORS optional
CORS_ORIGIN=*
