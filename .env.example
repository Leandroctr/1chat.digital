PORT=3000
NODE_ENV=local
# WAHA
# ATENCAO:
# Producao Railway: use a URL publica do WAHA via Cloudflare Tunnel:
# WAHA_URL=https://waha.1chat.digital
# WAHA_BASE_URL=https://waha.1chat.digital
# PC local: WAHA roda via Docker em http://localhost:3000.
# localhost:3001 e referencia antiga/legada, nao usar como padrao atual.
WAHA_URL=http://localhost:3000
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=CHANGE_ME
WAHA_SESSION=default
# PostgreSQL opcional
DATABASE_URL=
# IA opcional
GEMINI_API_KEY=
# Identificacao interna de plataforma com confirmacao segura
PLATFORM_CONFIRMATION_ENABLED=true
# CORS opcional
CORS_ORIGIN=*
