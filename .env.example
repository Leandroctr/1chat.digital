PORT=3000
NODE_ENV=local
# WAHA
# ATENCAO:
# Existe divergencia conhecida: o bot espera localhost:3001,
# mas o docker-compose.yml atual pode estar publicando WAHA em 3000.
# Nao mude isso aqui sem corrigir o docker-compose.yml junto.
WAHA_URL=http://localhost:3001
